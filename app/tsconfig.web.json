{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/shared/**/*",
    "src/preload/**/*",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue"
  ]
}
