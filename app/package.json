{
  "name": "ai-maru",
  "version": "0.0.0",
  "private": true,
  "description": "AI 코딩 통합 워크스페이스",
  "license": "MIT",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json && vue-tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:packaged": "app=\"$(../scripts/package-app.sh)\" && MARU_PACKAGED_APP=\"$app\" playwright test --project packaged",
    "postinstall": "[ \"$CI\" = true ] || install-electron"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@lobehub/icons-static-svg": "1.102.0",
    "@lucide/vue": "^1.70.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.330",
    "@xterm/addon-webgl": "0.20.0-beta.329",
    "@xterm/xterm": "6.1.0-beta.336",
    "dompurify": "^3.4.17",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "entities": "^9.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "marked": "^18.1.3",
    "overlayscrollbars": "^2.17.0",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
