{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/shared/**/*",
    "src/main/frame.ts",
    "src/main/session.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "e2e/**/*"
  ]
}
