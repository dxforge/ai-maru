{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/shared/**/*",
    "src/main/config-file.ts",
    "src/main/frame.ts",
    "src/main/pty.ts",
    "src/main/test-repo-env.ts",
    "src/renderer/src/font.ts",
    "src/renderer/src/icons.ts",
    "src/renderer/src/pty/seen.ts",
    "src/renderer/src/workspace/columns.ts",
    "src/renderer/src/workspace/layout.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "e2e/**/*"
  ]
}
