#!/bin/bash
# ai-maru claude shim
# 앱이 터미널 PATH 앞쪽에 두는 claude 다(docs/architecture.md 「claude 는 PATH 의 shim 이 plugin 을 싣는다」).
# claude 를 자식으로 띄우지 않고 exec 한다 — 앱이 foreground 리더로 claude 의 cwd 를 재고 이름을 보이기 때문이다.

real=
IFS=:
set -f
for dir in $PATH:; do
  dir=${dir:-.}
  [[ -f $dir/claude && -x $dir/claude ]] || continue
  # 둘째 줄로 shim 을 알아보고 건너뛴다. 자기 자신만 건너뛰면, 설치한 앱의 터미널에서 띄운 dev 앱처럼 다른 앱의 shim 이
  # PATH 에 함께 있을 때 두 shim 이 서로를 exec 하며 끝나지 않는다.
  second=
  { IFS= read -r _ && IFS= read -r second; } < "$dir/claude" 2> /dev/null
  [[ $second == '# ai-maru claude shim' ]] && continue
  real=$dir/claude
  break
done
if [[ -z $real ]]; then
  echo 'claude: command not found' >&2
  exit 127
fi

# claude 안(CLAUDECODE)에서 부른 claude 는 이 pane 의 claude 가 아니다. plugin 을 실으면 SessionStart hook 이 그 claude 에게 이 pane 의 pty 라고 알리고 monitor 가 이 pane 의 알림을 받으므로, plugin 없이 그대로 넘긴다.
if [[ -z $MARU_CLI || -z $MARU_CLAUDE_PLUGIN || -n $CLAUDECODE ]]; then
  exec "$real" "$@"
fi

# 이 앱의 터미널 env 에서는 claude 가 FORCE_HYPERLINK 가 있을 때만 OSC 8 링크를 찍는다. 값은 claude 프로세스에만 붙인다.
# 자식에게 물려주면 Bash 도구가 돌리는 CLI 가 파이프에 OSC 8 을 섞기 때문이다. zsh 는 로그인 여부와 상관없이
# `$ZDOTDIR/.zshenv` 를 읽으므로, ZDOTDIR 을 앱 디렉토리로 되돌려 Bash 도구의 zsh 가 앱 .zshenv 맨 위에서 지우게 한다.
# bash 는 그 파일을 읽지 않으므로 SHELL 이 zsh 일 때만 붙인다. Claude Code 의 Bash 도구가 SHELL 의 셸을 띄운다는 것은
# 확인하지 않았다.
if [[ -z ${FORCE_HYPERLINK+set} && -n $MARU_ZDOTDIR && ${SHELL##*/} == zsh ]]; then
  export FORCE_HYPERLINK=1 MARU_CLAUDE_FORCED_HYPERLINK=1 ZDOTDIR=$MARU_ZDOTDIR
fi
exec "$real" --plugin-dir "$MARU_CLAUDE_PLUGIN" "$@"
